{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>jacaudi/renovate-config:base",
    "github>jacaudi/renovate-config:go",
    "github>jacaudi/renovate-config:kubernetes"
  ],
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "description": "The Authentik API client is pinned to the Authentik version the operator is tested against; review these bumps on their own",
      "matchPackageNames": ["/^goauthentik\\.io//"],
      "groupName": "authentik-api"
    }
  ]
}
